---
import { NAV, SITE, EXPERTISES } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer on-deep">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label={`${SITE.name} — accueil`}>
          <svg class="brand__mark" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="20" cy="20" r="18.5" /><circle cx="20" cy="20" r="14.5" stroke-opacity=".45" /><path d="M14.5 28V12h6.3a4.6 4.6 0 0 1 0 9.2H14.5m6.6 0L26 28" /></svg>
          <span class="brand__name">Réseau Antiquaires</span>
        </a>
        <p>Un groupement d’experts et d’antiquaires indépendants, réunis par une charte commune d’estimation, d’expertise et d’achat.</p>
      </div>
      <nav class="footer-col" aria-label="Le site">
        <h2>Le site</h2>
        <ul>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-label="Expertises">
        <h2>Expertises</h2>
        <ul>{EXPERTISES.slice(0, 5).map((e) => <li><a href={`/expertises/#${e.id}`}>{e.name}</a></li>)}</ul>
      </nav>
      <div class="footer-col">
        <h2>Nous écrire</h2>
        <ul>
          <li><a href={SITE.contactPath}>Demander une expertise</a></li>
          <li><a href="/contact/">Contacter le Réseau</a></li>
          <li><a href="/contact/#formulaire">Rejoindre le Réseau</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <span>© {year} Réseau Antiquaires · reseau-antiquaires.fr</span>
      <span>Photographies : Pexels, Wikimedia Commons (CC0, CC BY, CC BY-SA) — <a href="/mentions-legales/#credits">crédits détaillés</a></span>
      <a href="/mentions-legales/">Mentions légales</a>
    </div>
  </div>
</footer>
