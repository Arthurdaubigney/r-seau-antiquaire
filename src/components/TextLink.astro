---
interface Props { href: string; label: string; class?: string }
const { href, label, class: cls = '' } = Astro.props;
---
<a class={`link link--arrow ${cls}`.trim()} href={href}>
  <span>{label}</span>
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 10h13M11 4.5 16.5 10 11 15.5" /></svg>
</a>
