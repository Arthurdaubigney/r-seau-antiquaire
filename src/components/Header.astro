---
import { NAV, SITE } from '../config/site';
import Cta from './Cta.astro';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${SITE.name} — accueil`}>
      <svg class="brand__mark" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
        <circle cx="20" cy="20" r="18.5" /><circle cx="20" cy="20" r="14.5" stroke-opacity=".45" />
        <path d="M14.5 28V12h6.3a4.6 4.6 0 0 1 0 9.2H14.5m6.6 0L26 28" />
      </svg>
      <span class="brand__name">Réseau Antiquaires</span>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined} class="link">{n.label}</a>)}
      <Cta label="Demander une expertise" />
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
      <span data-menu-label>Menu</span><span class="menu-btn__bars" aria-hidden="true"></span>
    </button>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" data-menu data-open="false" role="dialog" aria-label="Menu">
  {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
  <a href="/contact/">Contact</a>
  <Cta label="Demander une expertise" />
</div>
