---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
---
<Base title="Page introuvable | Réseau Antiquaires" description="La page demandée n'existe pas ou a été déplacée. Retrouvez le Réseau Antiquaires depuis l'accueil." noindex>
  <section class="hero">
    <div class="wrap" data-enter>
      <span class="eyebrow" style="--i:0">Erreur 404</span>
      <h1 style="--i:1">Cette page est introuvable</h1>
      <p class="lede" style="--i:2">Elle a peut-être été déplacée. Reprenez depuis l’accueil ou écrivez-nous.</p>
      <div class="actions" style="--i:3"><Cta label="Retour à l’accueil" href="/" /><Cta label="Contacter le Réseau" href="/contact/" variant="ghost" /></div>
    </div>
  </section>
</Base>
