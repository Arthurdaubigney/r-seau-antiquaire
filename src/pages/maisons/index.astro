---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Cta from '../../components/Cta.astro';
import { REGIONS } from '../../config/site';
---
<Base
  title="Les maisons du Réseau Antiquaires — antiquaires en France"
  description="Six régions françaises, des maisons d’antiquités indépendantes : le Réseau Antiquaires oriente votre demande vers l’expert le plus proche de chez vous."
  crumbs={[{ name: 'Les maisons', path: '/maisons/' }]}
>
  <section class="page-hero">
    <div class="wrap" data-enter>
      <span class="eyebrow" style="--i:0">Les maisons</span>
      <h1 style="--i:1">Les maisons d’antiquaires du Réseau, dans six régions</h1>
      <p class="lede" style="--i:2">Chaque maison est indépendante, installée dans sa région depuis de longues années et reconnue dans ses spécialités.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-labelledby="regions">
    <div class="wrap">
      <div class="split" style="align-items:start">
        <div>
          <h2 id="regions" style="margin-bottom:var(--s4)">Où nous trouver</h2>
          <ul class="regions">
            {REGIONS.map((r) => <li><h3>{r.name}</h3><p>{r.focus}</p></li>)}
          </ul>
        </div>
        <Photo name="f15094844" frame="tall" eager />
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="orientation">
    <div class="wrap">
      <div class="split split--wide-text">
        <div class="head" style="margin-bottom:0">
          <span class="eyebrow">Orientation</span>
          <h2 id="orientation">Une seule porte d’entrée</h2>
          <p class="lede">Vous n’avez pas à choisir une maison : indiquez votre objet et votre région, le Réseau fait le lien. Les coordonnées de la maison vous sont communiquées au premier échange.</p>
        </div>
        <div class="actions" style="margin-top:0"><Cta label="Contacter le Réseau" href="/contact/#formulaire" /></div>
      </div>
    </div>
  </section>
</Base>
